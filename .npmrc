# Turns the `engines` floor in package.json into a refusal rather than a
# warning. The floor is real: scripts/check-built.mjs imports the locale files
# as TypeScript, which Node only reads without a flag from 22.18 — and npm's
# default is to print the mismatch and install anyway, so the build failed
# several minutes later on ERR_UNKNOWN_FILE_EXTENSION, which names the symptom
# and not the cause. Failing at install says the version, and says it once.
engine-strict=true
