# The origin this site is served from. Not a secret, so it is committed:
# a build that cannot see it silently drops the canonical link and sitemap.
VITE_SITE_ORIGIN=https://sokki.voke-dev.com

# Cloudflare Web Analytics, for this subdomain only.
#
# Not a secret — it ships in the HTML of every page it measures. It is here
# rather than hard-coded so that a fork of this repository does not report into
# someone else's dashboard, and so a local build carries no beacon at all.
#
# Get it from Web Analytics -> Add a site -> hostname sokki.voke-dev.com. It
# will say the hostname is not one of your sites and offer the JS snippet: that
# is expected. A "site" there means a zone, and a subdomain is a record inside
# one, so manual installation is the only route — and the one that isolates this
# project's numbers from the rest of the domain.
VITE_CF_BEACON_TOKEN=
