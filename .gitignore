# Dependencies
node_modules

# Build output
dist
dev-dist

# Local environment. Secrets are not committed; two files are.
#
# .env.example documents what exists. .env.production carries the site origin,
# which is public by definition — it is the address people type — and has to be
# in the repo, because a build that cannot see it drops the canonical link and
# sitemap.xml without failing.
.env
.env.*
!.env.example
!.env.production

# Tooling caches and scratch
.vite
.wrangler
coverage
*.log
.playwright-mcp

# Editors and OS
.DS_Store
.idea
*.local
