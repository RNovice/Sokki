# Dependencies
node_modules

# Build output
dist
dev-dist

# Local environment. Only the example is committed.
#
# Nothing the build needs is a secret, but nothing it needs is in the repo
# either: the site origin and the analytics token are both properties of a
# deployment rather than of this code, and a fork that inherited them would
# claim our canonical URL and report into our dashboard. They are set on
# Cloudflare, in Settings -> Build -> Build Variables and Secrets.
.env
.env.*
!.env.example

# Tooling caches and scratch
.vite
.wrangler
coverage
*.log
.playwright-mcp

# Editors and OS
.DS_Store
.idea
*.local
